{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "experimentalSortPackageJson": false,
  "ignorePatterns": [
    "build/**",
    "release/**",
    "prebuilt/**",
    "android/**/build/**",
    "node_modules/**",
    "**/node_modules/**",
    ".memory/**",
    ".papercuts/**",
    ".agents/**",
    ".superpowers/**",
    "resources/generative-ui/**",
    "packages/cli/dist/**",
    "THIRD_PARTY_NOTICES.md",
    "resources/**/LICENSE*.md",
    "docs/plans/completed/**",
    "**/CHANGELOG.md",
    "ios/TESTFLIGHT.md",
    "docs/superpowers/**",
    "docs/audits/**",
    "docs/release-notes/**",
    "protocol/**",
    "resources/model-capabilities.json",
    "resources/aiden-help/manifest.json",
    "resources/bot-computers/lume-artifact.json",
    "resources/computer-use/cua-driver-artifact.json",
    "docs/research/experiments/task-quality-fixtures/**",
    "scripts/pullfrog-runtime-preload.mjs",
    "scripts/pullfrog-locked-runtime.mjs",
    "scripts/pullfrog-locked-runtime-core.mjs",
    "ios/**/*.xcassets/**",
    "ios/**/*.icon/**",
    "ios/APP_STORE_METADATA.md",
    "gui/themes/**",
    "docs/**/*.html"
  ]
}
