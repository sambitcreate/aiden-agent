{
  "name": "aiden-cli",
  "version": "0.1.0",
  "description": "Aiden Agent CLI \u2014 a pi-based headless coding agent with a full TUI",
  "type": "module",
  "private": true,
  "piConfig": {
    "name": "aiden",
    "configDir": ".aiden"
  },
  "bin": {
    "aiden": "dist/app/cli.js"
  },
  "files": [
    "dist/app",
    "themes",
    "README.md"
  ],
  "scripts": {
    "build": "node --experimental-strip-types scripts/generate-themes.ts && node scripts/patch-branding.mjs && node scripts/build.mjs",
    "themes": "node --experimental-strip-types scripts/generate-themes.ts",
    "test": "node --test tests/bundle.test.mjs tests/runtime.test.mjs tests/themes.test.mjs tests/extensions.test.mjs tests/skill-paths.test.mjs tests/parity.test.mjs",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@earendil-works/chord": "1.0.3",
    "@earendil-works/pi-coding-agent": "1.0.3",
    "@silvia-odwyer/photon-node": "0.3.4",
    "qrcode": "^1.5.4",
    "quickjs-wasi": "3.6.2",
    "@earendil-works/pi-ai": "1.0.3",
    "@earendil-works/pi-agent-core": "1.0.3",
    "@earendil-works/pi-codemode": "1.0.3",
    "@earendil-works/pi-mcp": "1.0.3",
    "proper-lockfile": "4.1.2"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/qrcode": "^1.5.5",
    "esbuild": "0.28.1",
    "https-proxy-agent": "7.0.6",
    "typescript": "5.9.3",
    "@types/proper-lockfile": "4.1.4"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "MIT",
  "optionalDependencies": {
    "sherpa-onnx-node": "1.13.4"
  }
}
