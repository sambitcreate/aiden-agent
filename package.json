{
  "name": "aiden-agent",
  "version": "1.0.0",
  "productName": "Aiden Agent",
  "description": "A private macOS AI workspace agent for local and cloud models",
  "author": "Sambit Biswas",
  "private": true,
  "type": "module",
  "main": "build/main/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/sambitcreate/aiden-agent.git"
  },
  "scripts": {
    "build": "vite build && npm run build:electron",
    "build:electron": "node scripts/build-electron.mjs",
    "dev": "npm run build:electron && concurrently -k -s first \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite --host 127.0.0.1 --port 4143 --strictPort",
    "dev:electron": "wait-on http-get://127.0.0.1:4143/main-window.html && AIDEN_RENDERER_URL=http://127.0.0.1:4143 electron .",
    "lint": "eslint .",
    "test": "tsx --test main/services/chat-title-policy.test.ts main/services/chat-store-core.test.ts main/services/external-editors.test.ts renderer/lib/editor-preference.test.ts",
    "type-check": "tsc --noEmit",
    "format": "oxfmt .",
    "package": "npm run build && electron-builder --mac dir",
    "dist": "npm run build && electron-builder --mac"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.80.6",
    "@earendil-works/pi-ai": "^0.80.6",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@radix-ui/colors": "^3.0.0",
    "@tanstack/react-query": "^5.87.4",
    "@tanstack/react-router": "^1.131.36",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "highlight.js": "^11.9.0",
    "katex": "^0.16.47",
    "lucide-react": "^0.542.0",
    "node-pty": "^1.1.0",
    "radix-ui": "^1.4.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^9.0.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "sherpa-onnx-node": "^1.12.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@rolldown/plugin-babel": "^0.2.1",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitejs/plugin-react": "^6.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^10.0.3",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.27.4",
    "eslint": "^9.39.2",
    "eslint-plugin-import": "^2.31.0",
    "globals": "^17.3.0",
    "oxfmt": "^0.26.0",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.20.5",
    "typescript": "^5.5.3",
    "vite": "^8.0.2",
    "wait-on": "^9.0.10"
  },
  "engines": {
    "node": ">=22.19"
  },
  "packageManager": "npm@11.11.0+sha512-82gRxKrh/eY5UnNorkTFcdBQAGpgjWehkfGVqAGlJjejEtJZGGJUqjo3mbBTNbc5BTnPKGVtGPBZGhElujX5cw==",
  "build": {
    "appId": "com.sambitcreate.aiden-agent",
    "productName": "Aiden Agent",
    "asar": true,
    "npmRebuild": false,
    "asarUnpack": [
      "**/node_modules/sherpa-onnx-node/**",
      "**/node_modules/sherpa-onnx-darwin-*/**",
      "**/node_modules/node-pty/**"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "build/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "resources/app-icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Aiden Agent uses the microphone only when you choose voice input or dictation."
      }
    }
  }
}
