// esbuild reads the nearest tsconfig for each file. This one keeps the root `paths`
// entry ("*" -> node_modules) from turning main's bare imports into bundled
// path imports; scripts/main-runtime-dependencies.test.mjs fails without it.
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "node16",
    "lib": ["ES2022"],
    "outDir": "../build/main",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "types": ["node", "electron"]
  },
  "include": ["./**/*.ts"],
  "exclude": ["node_modules"]
}
