// esbuild reads the nearest tsconfig for each file. This one keeps the root `paths`
// entry ("*" -> node_modules) from turning main's bare imports into bundled
// path imports; scripts/main-runtime-dependencies.test.mjs fails without it.
{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "outDir": "../build/main",
    "rootDir": "..",
    "noEmit": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowSyntheticDefaultImports": true,
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "types": ["node", "electron"]
  },
  "include": ["./**/*.ts", "../renderer/shared/**/*.ts", "../renderer/global.d.ts"],
  "exclude": ["node_modules"]
}
