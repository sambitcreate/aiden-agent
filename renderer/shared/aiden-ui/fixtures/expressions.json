{
  "version": 1,
  "locale": "en-US",
  "vars": {
    "data": {
      "totals": { "revenue": 6930, "margin": 0.31 },
      "byRegion": [
        { "region": "EMEA", "revenue": 2400, "margin": 0.28 },
        { "region": "AMER", "revenue": 3100, "margin": 0.35 },
        { "region": "APAC", "revenue": 1430, "margin": 0.27 }
      ],
      "__proto__": { "polluted": true },
      "label": "Q3"
    },
    "metric": "revenue",
    "count": 3,
    "flag": false,
    "empty": "",
    "nothing": null,
    "list": [4, 1, 3]
  },
  "cases": [
    { "name": "literal string", "expr": { "op": "lit", "v": "hi" }, "expect": "hi" },
    { "name": "literal number", "expr": { "op": "lit", "v": 2.5 }, "expect": 2.5 },
    { "name": "literal null", "expr": { "op": "lit", "v": null }, "expect": null },
    { "name": "var", "expr": { "op": "var", "name": "metric" }, "expect": "revenue" },
    { "name": "missing var", "expr": { "op": "var", "name": "ghost" }, "expectUndefined": true },
    { "name": "dynamic member", "expr": { "op": "get", "of": { "op": "get", "of": { "op": "var", "name": "data" }, "key": { "op": "lit", "v": "totals" } }, "key": { "op": "var", "name": "metric" } }, "expect": 6930 },
    { "name": "array index", "expr": { "op": "get", "of": { "op": "get", "of": { "op": "get", "of": { "op": "var", "name": "data" }, "key": { "op": "lit", "v": "byRegion" } }, "key": { "op": "lit", "v": 1 } }, "key": { "op": "lit", "v": "region" } }, "expect": "AMER" },
    { "name": "non-integer index", "expr": { "op": "get", "of": { "op": "var", "name": "list" }, "key": { "op": "lit", "v": 0.5 } }, "expectUndefined": true },
    { "name": "length is not a property", "expr": { "op": "get", "of": { "op": "var", "name": "list" }, "key": { "op": "lit", "v": "length" } }, "expectUndefined": true },
    { "name": "constructor blocked", "expr": { "op": "get", "of": { "op": "var", "name": "data" }, "key": { "op": "lit", "v": "constructor" } }, "expectUndefined": true },
    { "name": "__proto__ blocked", "expr": { "op": "get", "of": { "op": "var", "name": "data" }, "key": { "op": "lit", "v": "__proto__" } }, "expectUndefined": true },
    { "name": "member of null", "expr": { "op": "get", "of": { "op": "var", "name": "nothing" }, "key": { "op": "lit", "v": "x" } }, "expectUndefined": true },
    { "name": "add numbers", "expr": { "op": "bin", "o": "+", "l": { "op": "lit", "v": 2 }, "r": { "op": "lit", "v": 3 } }, "expect": 5 },
    { "name": "concat", "expr": { "op": "bin", "o": "+", "l": { "op": "lit", "v": "Break down " }, "r": { "op": "var", "name": "metric" } }, "expect": "Break down revenue" },
    { "name": "concat number", "expr": { "op": "bin", "o": "+", "l": { "op": "lit", "v": "n=" }, "r": { "op": "var", "name": "count" } }, "expect": "n=3" },
    { "name": "concat missing is empty", "expr": { "op": "bin", "o": "+", "l": { "op": "lit", "v": "a" }, "r": { "op": "var", "name": "ghost" } }, "expect": "a" },
    { "name": "strict equality", "expr": { "op": "bin", "o": "==", "l": { "op": "var", "name": "metric" }, "r": { "op": "lit", "v": "revenue" } }, "expect": true },
    { "name": "no coercion", "expr": { "op": "bin", "o": "==", "l": { "op": "lit", "v": 3 }, "r": { "op": "lit", "v": "3" } }, "expect": false },
    { "name": "not equal", "expr": { "op": "bin", "o": "!=", "l": { "op": "var", "name": "count" }, "r": { "op": "lit", "v": 4 } }, "expect": true },
    { "name": "less than", "expr": { "op": "bin", "o": "<", "l": { "op": "lit", "v": 2 }, "r": { "op": "var", "name": "count" } }, "expect": true },
    { "name": "mixed ordering is false", "expr": { "op": "bin", "o": ">=", "l": { "op": "lit", "v": "b" }, "r": { "op": "lit", "v": 1 } }, "expect": false },
    { "name": "or returns operand", "expr": { "op": "bin", "o": "||", "l": { "op": "var", "name": "empty" }, "r": { "op": "lit", "v": "fallback" } }, "expect": "fallback" },
    { "name": "and short-circuits", "expr": { "op": "bin", "o": "&&", "l": { "op": "var", "name": "flag" }, "r": { "op": "var", "name": "ghost" } }, "expect": false },
    { "name": "not", "expr": { "op": "not", "e": { "op": "var", "name": "empty" } }, "expect": true },
    { "name": "ternary", "expr": { "op": "if", "test": { "op": "var", "name": "flag" }, "then": { "op": "lit", "v": "yes" }, "else": { "op": "lit", "v": "no" } }, "expect": "no" },
    { "name": "fmt currency", "expr": { "op": "call", "fn": "fmt", "a": [{ "op": "lit", "v": 6930 }, { "op": "lit", "v": "currency" }] }, "expect": "$6,930.00" },
    { "name": "fmt currency code", "expr": { "op": "call", "fn": "fmt", "a": [{ "op": "lit", "v": 12.5 }, { "op": "lit", "v": "currency" }, { "op": "lit", "v": "EUR" }] }, "expect": "€12.50" },
    { "name": "fmt percent", "expr": { "op": "call", "fn": "fmt", "a": [{ "op": "lit", "v": 0.315 }, { "op": "lit", "v": "percent" }] }, "expect": "31.5%" },
    { "name": "fmt number", "expr": { "op": "call", "fn": "fmt", "a": [{ "op": "lit", "v": 1234567.891 }, { "op": "lit", "v": "number" }] }, "expect": "1,234,567.89" },
    { "name": "fmt date", "expr": { "op": "call", "fn": "fmt", "a": [{ "op": "lit", "v": "2026-10-09" }, { "op": "lit", "v": "date" }] }, "expect": "Oct 9, 2026" },
    { "name": "fmt numeric string", "expr": { "op": "call", "fn": "fmt", "a": [{ "op": "lit", "v": "42" }, { "op": "lit", "v": "number" }] }, "expect": "42" },
    { "name": "fmt missing", "expr": { "op": "call", "fn": "fmt", "a": [{ "op": "var", "name": "ghost" }, { "op": "lit", "v": "number" }] }, "expect": "" },
    { "name": "len list", "expr": { "op": "call", "fn": "len", "a": [{ "op": "var", "name": "list" }] }, "expect": 3 },
    { "name": "len string", "expr": { "op": "call", "fn": "len", "a": [{ "op": "lit", "v": "abcd" }] }, "expect": 4 },
    { "name": "len other", "expr": { "op": "call", "fn": "len", "a": [{ "op": "var", "name": "count" }] }, "expect": 0 },
    { "name": "sum list", "expr": { "op": "call", "fn": "sum", "a": [{ "op": "var", "name": "list" }] }, "expect": 8 },
    { "name": "sum field", "expr": { "op": "call", "fn": "sum", "a": [{ "op": "get", "of": { "op": "var", "name": "data" }, "key": { "op": "lit", "v": "byRegion" } }, { "op": "lit", "v": "revenue" }] }, "expect": 6930 },
    { "name": "max field", "expr": { "op": "call", "fn": "max", "a": [{ "op": "get", "of": { "op": "var", "name": "data" }, "key": { "op": "lit", "v": "byRegion" } }, { "op": "lit", "v": "margin" }] }, "expect": 0.35 },
    { "name": "min variadic", "expr": { "op": "call", "fn": "min", "a": [{ "op": "lit", "v": 5 }, { "op": "lit", "v": 2 }, { "op": "lit", "v": 9 }] }, "expect": 2 },
    { "name": "max empty", "expr": { "op": "call", "fn": "max", "a": [{ "op": "json", "v": [] }] }, "expectUndefined": true },
    { "name": "round", "expr": { "op": "call", "fn": "round", "a": [{ "op": "lit", "v": 0.31456 }, { "op": "lit", "v": 2 }] }, "expect": 0.31 },
    { "name": "round integer", "expr": { "op": "call", "fn": "round", "a": [{ "op": "lit", "v": 2.5 }] }, "expect": 3 },
    { "name": "filter", "expr": { "op": "call", "fn": "len", "a": [{ "op": "call", "fn": "filter", "a": [{ "op": "get", "of": { "op": "var", "name": "data" }, "key": { "op": "lit", "v": "byRegion" } }, { "op": "lit", "v": "region" }, { "op": "lit", "v": "EMEA" }] }] }, "expect": 1 },
    { "name": "sort desc", "expr": { "op": "get", "of": { "op": "get", "of": { "op": "call", "fn": "sort", "a": [{ "op": "get", "of": { "op": "var", "name": "data" }, "key": { "op": "lit", "v": "byRegion" } }, { "op": "lit", "v": "revenue" }, { "op": "lit", "v": "desc" }] }, "key": { "op": "lit", "v": 0 } }, "key": { "op": "lit", "v": "region" } }, "expect": "AMER" },
    { "name": "sort plain list", "expr": { "op": "call", "fn": "sort", "a": [{ "op": "var", "name": "list" }] }, "expect": [1, 3, 4] },
    { "name": "json literal", "expr": { "op": "json", "v": [{ "value": "a", "label": "A" }] }, "expect": [{ "value": "a", "label": "A" }] },
    { "name": "unknown op", "expr": { "op": "eval", "v": "1" }, "expectUndefined": true }
  ]
}
