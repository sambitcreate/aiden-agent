{
  "version": 1,
  "description": "Canonical failure-ambiguity matrix for Aiden Remote idempotent mutations across server, iOS, and Android. Compares beforeEffectRefusal routes (custom-receipt / state-check routes such as Bot peers, open-work, resume, watches, and routine-models where only recognized non-transient 4xx codes prove no side effect occurred) against cachedRejectionLedger routes (executeAidenDurableOperation routes backed by AidenIdempotencyLedger where settled rejections are cached for 24h and unrecorded/unknown outcomes return 409 idempotency_in_flight).",
  "policies": {
    "beforeEffectRefusal": "Only a structured non-transient 4xx response (400-499 excluding 408 and 429) whose error code is on recognizedBeforeEffectCodes proves no side effect occurred. 409 idempotency_in_flight (including post-effect authorization loss on Bot peers and open-work), 409 internal_error, unknown codes, 408/429/5xx, unparsed HTTP responses, transport losses, and cancellations remain ambiguous.",
    "cachedRejectionLedger": "Backed by executeAidenDurableOperation and AidenIdempotencyLedger. Structured non-transient 4xx responses (including replayed settled rejections such as 409 internal_error and 409 idempotency_conflict) settle the attempt; 409 idempotency_in_flight, 408/429/5xx, unparsed HTTP responses, transport losses, and cancellations remain ambiguous so the caller retains its idempotency key."
  },
  "recognizedBeforeEffectCodes": [
    "invalid_request",
    "payload_too_large",
    "authentication_required",
    "credential_revoked",
    "capability_denied",
    "server_identity_changed",
    "not_found",
    "bot_archived",
    "operation_stale",
    "bot_paused",
    "idempotency_conflict",
    "idempotency_capacity",
    "rate_limited",
    "revision_conflict",
    "already_exists",
    "handle_invalid",
    "handle_expired",
    "handle_wrong_device",
    "handle_capacity",
    "approval_already_resolved",
    "approval_resolved",
    "approval_expired",
    "question_already_resolved",
    "question_expired",
    "memory_entry_not_found",
    "memory_over_budget",
    "memory_blocked",
    "routine_proposal_not_found",
    "handoff_expired",
    "access_request_expired",
    "plan_expired"
  ],
  "cases": [
    {
      "name": "outcome unrecorded or post-effect authorization lost",
      "kind": "server",
      "status": 409,
      "code": "idempotency_in_flight",
      "beforeEffectRefusal": { "ambiguous": true },
      "cachedRejectionLedger": { "ambiguous": true },
      "serverScenario": "outcome_unrecorded"
    },
    {
      "name": "crashed in-flight entry restored on restart",
      "kind": "server",
      "status": 409,
      "code": "idempotency_in_flight",
      "beforeEffectRefusal": { "ambiguous": true },
      "cachedRejectionLedger": { "ambiguous": true },
      "serverScenario": "restored_in_flight"
    },
    {
      "name": "optimistic-concurrency revision mismatch before effect",
      "kind": "server",
      "status": 409,
      "code": "revision_conflict",
      "beforeEffectRefusal": { "ambiguous": false },
      "cachedRejectionLedger": { "ambiguous": false },
      "serverScenario": "replayed_revision_conflict"
    },
    {
      "name": "replayed settled internal_error rejection from ledger",
      "kind": "server",
      "status": 409,
      "code": "internal_error",
      "beforeEffectRefusal": { "ambiguous": true },
      "cachedRejectionLedger": { "ambiguous": false },
      "serverScenario": "replayed_internal_error"
    },
    {
      "name": "idempotency key reused with a different request body",
